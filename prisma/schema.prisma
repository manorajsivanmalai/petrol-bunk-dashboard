generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  ATTENDANT
  ACCOUNTANT
}

enum FuelType {
  PETROL
  DIESEL
  XP95
}

enum PaymentMode {
  CASH
  CREDIT
  UPI
}

enum ShiftStatus {
  LIVE
  CLOSED
}

enum ApprovalType {
  FUEL_ISSUE
  CREDIT_SALE
  SHIFT_CLOSE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CreditTransactionType {
  DEBIT
  PAYMENT
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  email        String?   @unique
  passwordHash String
  role         Role
  phone        String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime?

  shifts             Shift[]
  fuelEntries        FuelEntry[]   @relation("FuelEntryCreatedBy")
  requestedApprovals Approval[]    @relation("ApprovalRequestedBy")
  decidedApprovals   Approval[]    @relation("ApprovalDecidedBy")
  activity           ActivityLog[]
}

model Pump {
  id     String  @id @default(cuid())
  name   String  @unique
  shifts Shift[]
}

model Shift {
  id               String      @id @default(cuid())
  pump             Pump        @relation(fields: [pumpId], references: [id])
  pumpId           String
  attendant        User        @relation(fields: [attendantId], references: [id])
  attendantId      String
  status           ShiftStatus @default(LIVE)
  startedAt        DateTime    @default(now())
  endedAt          DateTime?
  openingReading   Decimal     @default(0)
  closingReading   Decimal?
  volumeL          Decimal     @default(0)
  collectionAmount Decimal     @default(0)

  fuelEntries FuelEntry[]

  @@index([status])
}

model Customer {
  id                String   @id @default(cuid())
  name              String
  contactPhone      String?
  creditLimit       Decimal  @default(0)
  outstandingAmount Decimal  @default(0)
  status            String   @default("Active")
  createdAt         DateTime @default(now())

  vehicles           Vehicle[]
  fuelEntries        FuelEntry[]
  creditTransactions CreditTransaction[]
}

model Vehicle {
  id            String   @id @default(cuid())
  vehicleNumber String   @unique
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  createdAt     DateTime @default(now())

  @@index([customerId])
}

model FuelEntry {
  id            String      @id @default(cuid())
  shift         Shift       @relation(fields: [shiftId], references: [id])
  shiftId       String
  fuelType      FuelType
  quantityL     Decimal
  ratePerL      Decimal
  amount        Decimal
  vehicleNumber String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  customerId    String?
  paymentMode   PaymentMode @default(CASH)
  createdBy     User        @relation("FuelEntryCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime    @default(now())
  status        String      @default("Recorded")
  tallySyncedAt DateTime?

  creditTransactions CreditTransaction[]
  approvals          Approval[]

  @@index([createdAt])
}

model CreditTransaction {
  id          String                @id @default(cuid())
  customer    Customer              @relation(fields: [customerId], references: [id])
  customerId  String
  fuelEntry   FuelEntry?            @relation(fields: [fuelEntryId], references: [id])
  fuelEntryId String?
  amount        Decimal
  type          CreditTransactionType
  note          String?
  createdAt     DateTime              @default(now())
  tallySyncedAt DateTime?
}

model Approval {
  id            String         @id @default(cuid())
  type          ApprovalType
  fuelEntry     FuelEntry?     @relation(fields: [fuelEntryId], references: [id])
  fuelEntryId   String?
  title         String
  detail        String?
  amount        Decimal
  status        ApprovalStatus @default(PENDING)
  requestedBy   User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedById String
  decidedBy     User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())

  @@index([status])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  icon      String   @default("◫")
  title     String
  summary   String
  status    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
