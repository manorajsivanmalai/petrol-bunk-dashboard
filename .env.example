# PostgreSQL connection string, e.g.
# postgresql://USER:PASSWORD@HOST:5432/kannusamy_agency?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kannusamy_agency?schema=public"

# Long, random string used to sign session JWTs. Generate one with:
#   openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"

# Optional overrides
SESSION_COOKIE_NAME="kannusamy_session"
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"
